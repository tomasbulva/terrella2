<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include DataStore preferences file for cloud backup (DataStore uses 'file' domain) -->
        <include domain="file" path="datastore/" />
        
        <!-- Include wallpaper files -->
        <include domain="file" path="wallpapers/" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Include DataStore preferences for device-to-device transfer (DataStore uses 'file' domain) -->
        <include domain="file" path="datastore/" />
        
        <!-- Include wallpaper files -->
        <include domain="file" path="wallpapers/" />
    </device-transfer>
</data-extraction-rules>
