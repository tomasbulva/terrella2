; Engine configuration file.
config_version=5

[application]

config/name="Terrella Spike"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07, 0.08, 0.1, 1)

[autoload]

Metrics="*res://scripts/metrics.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/frame_pacing/android/enable_frame_pacing=false

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[shader_globals]

night={
"type": "float",
"value": 0.0
}
snow={
"type": "float",
"value": 0.0
}
autumn={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
